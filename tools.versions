# The tools and files bundled with Aleph (docs/adr/0008, docs/adr/0081).
# scripts/bundle-tools.sh describes the rows; {tag} in an archive is the tag.
#
# golem and shem, checked against their releases' SHA256SUMS
# name  tag  archive
golem v0.1.0-rc4 golem-{tag}-aarch64-macos.tar.gz
shem v0.1.0-rc9 shem-{tag}-aarch64-apple-darwin.tar.gz
#
# llama.cpp, checked against the SHA-256 here (it has no SHA256SUMS)
# name  tag  archive  repository  sha256  files to copy
